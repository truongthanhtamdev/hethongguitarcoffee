{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000

	# Micro chỉ dùng cho phần lên dây đàn, và chỉ trên chính trang này.
	header {
		Permissions-Policy "microphone=(self), camera=(), geolocation=()"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Gõ kèm www vẫn vào được, nhưng dồn hết về một địa chỉ để khỏi chia đôi
# đường dẫn (và khỏi chia đôi cookie đăng nhập).
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
