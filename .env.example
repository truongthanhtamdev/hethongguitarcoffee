# Long random secret used to sign session cookies. Generate with e.g.
# `openssl rand -base64 48`. Keep it secret; changing it invalidates all
# existing logged-in sessions.
AUTH_SECRET=change-me-to-a-long-random-string

# Optional: where the SQLite database file is stored. Defaults to ./data
# relative to the project root.
# DATA_DIR=/var/lib/musicnote/data

# Tai khoan quan tri tao ra trong lan chay dau tien.
# De trong ADMIN_PASSWORD thi he thong tu sinh mat khau ngau nhien va in ra
# log khoi dong — xem bang: docker compose logs app
ADMIN_EMAIL=admin@guitarcafe.local
ADMIN_PASSWORD=

# Chay http tran (chua co HTTPS) thi dat false, khong thi dang nhap xong bam
# sang trang nao cung thanh chua dang nhap. Co HTTPS roi thi bo dong nay.
# COOKIE_SECURE=false
